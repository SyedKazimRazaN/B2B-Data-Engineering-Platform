e=13;fontColor=#1F2328;spacingLeft=12;" vertex="1" parent="c112"><mxGeometry x="0.0" y="0.0" width="330.0" height="26.0" as="geometry"/></mxCell><mxCell id="c114" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;html=1;" vertex="1" parent="c111"><mxGeometry x="0.0" y="70.0" width="330.0" height="26.0" as="geometry"/></mxCell><mxCell id="c115" value="pipeline_run_log" style="shape=partialRectangle;connectable=0;fillColor=#F6F8FA;top=0;left=0;bottom=0;right=0;html=1;overflow=hidden;whiteSpace=nowrap;fontFamily=Consolas;align=left;verticalAlign=middle;strokeColor=#D0D7DE;fontSize=13;fontColor=#1F2328;spacingLeft=12;" vertex="1" parent="c114"><mxGeometry x="0.0" y="0.0" width="330.0" height="26.0" as="geometry"/></mxCell><mxCell id="c116" value='&lt;b&gt;&lt;font face="Consolas" style="font-size:14.5px" color="#1F2328"&gt;Per-interface spec (ISD sections 4-6)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Interface ID, source object, target table&lt;br&gt;• Format, delimiter, header, encoding&lt;br&gt;• Frequency: initial backfill / daily incremental&lt;br&gt;• Extraction: incremental (watermark) vs full snapshot&lt;br&gt;• Load: APPEND (SQL Server) vs TRUNCATE + APPEND (CSV)&lt;br&gt;• Volume per run · SLA · error handling · re-run behaviour' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;fontSize=13.5;fontColor=#57606A;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1500.0" y="222.0" width="360.0" height="250.0" as="geometry"/></mxCell><mxCell id="c117" value='&lt;b&gt;&lt;font face="Consolas" style="font-size:14.5px" color="#1F2328"&gt;Error handling&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Each pipeline wraps its run in &lt;b&gt;&lt;font color="#1F2328"&gt;log_run_start / log_run_end&lt;/font&gt;&lt;/b&gt; → status, rows, error message in pipeline_run_log.&lt;br&gt;• Watermark advances &lt;b&gt;&lt;font color="#1F2328"&gt;only after a successful load&lt;/font&gt;&lt;/b&gt;, so a failed run is simply re-run.&lt;br&gt;• Windows toast on success / failure.' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;fontSize=13.5;fontColor=#57606A;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1500.0" y="502.0" width="360.0" height="170.0" as="geometry"/></mxCell><mxCell id="c118" value='&lt;b&gt;&lt;font face="Consolas" style="font-size:14.5px" color="#1F2328"&gt;Security&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Connection strings from &lt;b&gt;&lt;font color="#1F2328"&gt;.env&lt;/font&gt;&lt;/b&gt; (never committed).&lt;br&gt;• ODBC Driver 17 for SQL Server; SQLAlchemy engines.' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;fontSize=13.5;fontColor=#57606A;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1500.0" y="762.0" width="360.0" height="130.0" as="geometry"/></mxCell><mxCell id="c119" value="8 tables · SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A8C86;strokeWidth=1.8;startArrow=none;endArrow=block;startFill=0;endFill=1;startSize=12;endSize=9;exitX=1;exitY=0.7143;exitDx=0;exitDy=0;entryX=0;entryY=0.9000;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;fontSize=12;fontColor=#57606A;fontStyle=1;" edge="1" parent="1" source="c20" target="c51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c120" value="CSV" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1A8C86;strokeWidth=1.8;startArrow=none;endArrow=block;startFill=0;endFill=1;startSize=12;endSize=9;exitX=1;exitY=0.6557;exitDx=0;exitDy=0;e