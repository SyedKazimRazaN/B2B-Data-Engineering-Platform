 parent="c534"><mxGeometry x="0.0" y="0.0" width="52.0" height="26.0" as="geometry"/></mxCell><mxCell id="c536" value="updated_at" style="shape=partialRectangle;connectable=0;fillColor=#FFFFFF;top=0;left=0;bottom=0;right=0;html=1;overflow=hidden;whiteSpace=nowrap;fontFamily=Consolas;align=left;verticalAlign=middle;strokeColor=#D0D7DE;fontSize=13;fontColor=#1F2328;spacingLeft=8;" vertex="1" parent="c534"><mxGeometry x="52.0" y="0.0" width="229.8" height="26.0" as="geometry"/></mxCell><mxCell id="c537" value="TIMESTAMP" style="shape=partialRectangle;connectable=0;fillColor=#FFFFFF;top=0;left=0;bottom=0;right=0;html=1;overflow=hidden;whiteSpace=nowrap;fontFamily=Consolas;align=left;verticalAlign=middle;strokeColor=#D0D7DE;fontSize=12;fontColor=#8C959F;align=right;spacingRight=10;" vertex="1" parent="c534"><mxGeometry x="281.8" y="0.0" width="118.2" height="26.0" as="geometry"/></mxCell><mxCell id="c538" value="&lt;b&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:14.5px&quot; color=&quot;#1F2328&quot;&gt;Physical design notes&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Facts: &lt;b&gt;&lt;font color=&quot;#1F2328&quot;&gt;PARTITION BY RANGE (date_key)&lt;/font&gt;&lt;/b&gt;, one partition per month + a DEFAULT partition (partitioning.sql).&lt;br&gt;• Fact PKs include date_key, as PostgreSQL requires for partitioned tables.&lt;br&gt;• &lt;b&gt;&lt;font color=&quot;#1F2328&quot;&gt;dim_companies&lt;/font&gt;&lt;/b&gt; SCD 2: partial unique index on company_id WHERE is_current.&lt;br&gt;• B-tree indexes on every join key (&lt;span style='color:#0969DA'&gt;idx&lt;/span&gt;); dimensions CLUSTERed on their PK after each load.&lt;br&gt;• Surrogate keys are SERIAL; business IDs kept as CHAR(32)." style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;fontSize=13.5;fontColor=#57606A;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1960.0" y="