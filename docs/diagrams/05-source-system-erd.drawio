pace=nowrap;fontFamily=Consolas;align=left;verticalAlign=middle;strokeColor=#D0D7DE;fontSize=10.5;fontStyle=1;fontColor=#57606A;spacingLeft=10;" vertex="1" parent="c442"><mxGeometry x="0.0" y="0.0" width="52.0" height="26.0" as="geometry"/></mxCell><mxCell id="c444" value="is_bot" style="shape=partialRectangle;connectable=0;fillColor=#FFFFFF;top=0;left=0;bottom=0;right=0;html=1;overflow=hidden;whiteSpace=nowrap;fontFamily=Consolas;align=left;verticalAlign=middle;strokeColor=#D0D7DE;fontSize=13;fontColor=#1F2328;spacingLeft=8;" vertex="1" parent="c442"><mxGeometry x="52.0" y="0.0" width="206.8" height="26.0" as="geometry"/></mxCell><mxCell id="c445" value="bool" style="shape=partialRectangle;connectable=0;fillColor=#FFFFFF;top=0;left=0;bottom=0;right=0;html=1;overflow=hidden;whiteSpace=nowrap;fontFamily=Consolas;align=left;verticalAlign=middle;strokeColor=#D0D7DE;fontSize=12;fontColor=#8C959F;align=right;spacingRight=10;" vertex="1" parent="c442"><mxGeometry x="258.8" y="0.0" width="81.2" height="26.0" as="geometry"/></mxCell><mxCell id="c446" value='&lt;b&gt;&lt;font face="Consolas" style="font-size:14.5px" color="#1F2328"&gt;How to read this&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• &lt;b&gt;&lt;font color="#1F2328"&gt;Load order&lt;/font&gt;&lt;/b&gt; follows dependency levels: 0 Companies, Categories → 1 Customers, Suppliers, Products → 2 Supplier_Product_Mapping → 3 Orders → 4 Order_Items.&lt;br&gt;• All IDs are &lt;b&gt;&lt;font color="#1F2328"&gt;CHAR(32)&lt;/font&gt;&lt;/b&gt; UUIDs assigned by the Python generator (no IDENTITY).&lt;br&gt;• Every table has &lt;b&gt;&lt;font color="#1F2328"&gt;created_at / updated_at&lt;/font&gt;&lt;/b&gt;; CHECK &lt;b&gt;&lt;font color="#1F2328"&gt;updated_at ≥ created_at&lt;/font&gt;&lt;/b&gt;. updated_at drives the incremental watermark.&lt;br&gt;• &lt;b&gt;&lt;font color="#1F2328"&gt;Orders.lead_id&lt;/font&gt;&lt;/b&gt; is a plain reference: marketing leads live only in the CSV feed, so the join happens in PostgreSQL.&lt;br&gt;• Web logs are an independent stream; they connect to the model only at the analytics layer.' style="rounded=1;absoluteArcSize=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D0D7DE;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;fontSize=13.5;fontColor=#57606A;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1760.0" y="792.0" width="760.0" height="210.0" as="geometry"/></mxCell><mxCell id="c447" value="employs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#A8681A;strokeWidth=1.8;startArrow=ERmany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=12;endSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;fontSize=12;fontColor=#57606A;fontStyle=1;" edge="1" parent="1" source="c91" target="c29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400.0" y="275.0"/><mxPoint x="400.0" y="249.0"/></Array></mxGeometry></mxCell><mxCell id="c448" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#A8681A;strokeWidth=1.8;startArrow=ERmany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=12;endSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;fontSize=12;fontColor=#57606A;fontStyle=1;" edge="1" parent="1" source="c136" target="c29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="409.0" y="645.0"/><mxPoint x="409.0" y="249.0"/></Array></mxGeometry></mxCell><mxCell id="c449" value="classifies" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#A8681A;strokeWidth=1.8;startArrow=ERmany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=12;endSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;fontSize=12;fontColor=#57606A;fontStyle=1;" edge="1" parent="1" source="c177" target="c70"><mxGe