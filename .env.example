# Copy this file to .env and fill in your own local values.
# .env is gitignored — never commit real credentials.

# --------------------------------------------------
# SQL Server (Source 1 — operational B2B database)
# --------------------------------------------------
SQL_SERVER_NAME=YOUR_MACHINE_NAME\SQLEXPRESS
SQL_SERVER_DRIVER=ODBC Driver 17 for SQL Server
SQL_SERVER_DATABASE=b2b_source_db
# Windows auth: Trusted_Connection=yes
# SQL auth:     UID=your_user;PWD=your_password
SQL_SERVER_AUTH=Trusted_Connection=yes

# --------------------------------------------------
# PostgreSQL (Staging / Intermediate / Warehouse / Marts / Metadata)
# --------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRESQL_DATABASE=b2b_warehouse_db